# Alpaca market data (prices, indicators, news) and asset identity.
# Alpaca's own variable names APCA_API_KEY_ID / APCA_API_SECRET_KEY are accepted too.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# sip needs a paid Alpaca market-data plan; iex is the free feed. Set to false for a live-account key pair.
#TRADINGAGENTS_ALPACA_FEED=sip
#TRADINGAGENTS_ALPACA_PAPER=true

# SEC EDGAR (US company statements, as filed). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# LLM providers (set the ones you use). Ollama needs no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#OPENAI_COMPATIBLE_API_KEY=

# Ollama server. NVIDIA PAIR (Personal AI Router) routes every request across its cluster, all
# serving gemma4:26b: InfinitiDev 192.168.0.62 (RTX 5090, the dev box), Colossus 192.168.0.98
# (RTX A5000, where the worker container runs) and the DGX Spark PGX 192.168.0.95 (GB10).
# PAIR's Ollama-compatible proxy takes plaintext from loopback only (peers use mTLS; 14321 is the
# pairing port, not inference), so each machine talks to its own PAIR and a container needs host
# networking. The proxy's port differs by machine (11435 on InfinitiDev, 11434 on Colossus):
# `ss -ltnp | grep nvpair-proxy` lists it. Unset uses http://localhost:11434, plain Ollama.
#OLLAMA_BASE_URL=http://127.0.0.1:11435
# Context window asked of Ollama per request (the server default truncates the analysts' prompts).
#TRADINGAGENTS_OLLAMA_NUM_CTX=32768
# Hidden reasoning on thinking-capable models; off by default, it adds minutes per call.
#TRADINGAGENTS_OLLAMA_THINKING=false

# Override these DEFAULT_CONFIG keys. Provider, models and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=ollama
#TRADINGAGENTS_DEEP_THINK_LLM=gemma4:26b
#TRADINGAGENTS_QUICK_THINK_LLM=gemma4:26b
# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#TRADINGAGENTS_DEEP_THINK_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_PROVIDER=
#TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
#TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20
# concise keeps reports, debate turns and decisions short (faster); detailed lets the model run long.
#TRADINGAGENTS_REPORT_STYLE=concise
# tradingagents size: hedge with the weekly SPY call unless the monthly costs less than this times it.
#TRADINGAGENTS_HEDGE_MONTHLY_RATIO=2.1
# tradingagents size: take a call only when its target is more than this % from the close, long above, short below.
#TRADINGAGENTS_MIN_TARGET_PCT=5
# tradingagents size: the book is the top N longs and top N shorts by expected move to target.
#TRADINGAGENTS_NAMES_PER_SIDE=10
# tradingagents size: the stop when the desk gives none, as % from the close against the position.
#TRADINGAGENTS_DEFAULT_STOP_PCT=2
# The sweep runs around the clock: 3 processes outside market hours, 1 during them (the Watcher has the other
# PAIR nodes), rounds of 4 tickers a process, holdings first. The book is built at this Eastern time from every
# decision under the age limit, and placed at the open when WORKER_PLACE_BOOK is true.
#TRADINGAGENTS_DAILY_BOOK_TIME=09:00
#TRADINGAGENTS_DECISION_MAX_AGE_DAYS=5
#TRADINGAGENTS_DAILY_PARTS_MARKET_HOURS=1
#TRADINGAGENTS_SWEEP_ROUND_SIZE=4
#TRADINGAGENTS_OLLAMA_THINKING=true
#TRADINGAGENTS_DAILY_WATCHLIST=watchlists/sp500.txt
#TRADINGAGENTS_DAILY_PARTS=3
#TRADINGAGENTS_BENCH_SIZE=10
#TRADINGAGENTS_WORKER_PLACE_BOOK=true
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Time limits on every Ollama call, in seconds. idle: the longest silence between streamed chunks, which
# includes the wait in PAIR's queue. call: the whole call. Past either the call is dropped and fails closed.
#TRADINGAGENTS_OLLAMA_IDLE_TIMEOUT=600
#TRADINGAGENTS_OLLAMA_CALL_TIMEOUT=900
# A model, context window or call limit of its own for a tier ("quick", "deep") or an agent, as JSON.
#TRADINGAGENTS_AGENT_CALLS={"deep": {"timeout": 1200}, "Portfolio Manager": {"num_ctx": 65536}}

# Minutes without any answer from the model before the worker emails that it is down (and again when it is back).
#TRADINGAGENTS_MODEL_OUTAGE_MINUTES=15

# Typed contracts: what an agent does when its answer fails its schema twice. fail (default) closes the
# run as REVIEW; free_text answers in prose, for a provider without structured output.
#TRADINGAGENTS_CONTRACT_FALLBACK=fail
# Each analyst states a typed verdict after its report: one more quick-model call per analyst.
#TRADINGAGENTS_ANALYST_VERDICTS=true

# Feedback store: decisions, settled outcomes, per-agent scores and every agent's verdict. SQLite under
# ~/.tradingagents by default; on Colossus, the "edinburgh" Postgres database. Move an existing
# SQLite store across once with `tradingagents feedback-copy` (the destination must be empty).
#TRADINGAGENTS_FEEDBACK_DB_URL=postgresql+psycopg://edinburgh:<password>@192.168.0.98:5432/edinburgh
#TRADINGAGENTS_FEEDBACK_HOLD_BAND_PCT=2.0

# Paths and alpha benchmark. Unset uses ~/.tradingagents and SPY.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
